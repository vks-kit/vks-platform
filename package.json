{
  "name": "vks-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @vks-kit/gallery",
    "build": "npm run build -w @vks-kit/gallery",
    "dev:docs": "npm run dev -w @vks-kit/docs",
    "build:docs": "npm run build -w @vks-kit/docs",
    "deploy:docs": "npm run build:docs && npx wrangler pages deploy apps/docs/dist --project-name=vks-ui-docs --branch=main --commit-dirty=true",
    "test": "vitest run",
    "kit:publish": "node scripts/publish-kit.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ai:index": "vite-node --config vitest.config.ts scripts/ai-index.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}

